generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Factory {
  id          String           @id
  name        String
  slug        String           @unique
  status      String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deployments TwinDeployment[]
}

model DigitalTwin {
  id               String           @id
  twinKey          String           @unique
  displayName      String
  version          String
  manifestVersion  String
  sourceType       String
  sourceRef        String
  analysisOnly     Boolean          @default(true)
  description      String?
  ownerName        String?
  ownerRole        String?
  defaultModelProfiles Json?
  defaultBudgetPolicy  Json?
  defaultMemoryPolicy  Json?
  portableSkillBundle  Json?
  capabilityRoutes     Json?
  portablePromotionPolicy Json?
  deployments      TwinDeployment[]
  memoryPromotions MemoryPromotion[]
  createdAt        DateTime         @default(now())
}

model TwinDeployment {
  id                String               @id
  deploymentKey     String               @unique
  displayName       String?
  status            String
  analysisOnly      Boolean              @default(true)
  factoryId         String
  digitalTwinId     String
  memoryNamespaceId String?
  enabledPortableSkills Json?
  memoryFeatures       Json?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  factory           Factory              @relation(fields: [factoryId], references: [id])
  digitalTwin       DigitalTwin          @relation(fields: [digitalTwinId], references: [id])
  conversations     Conversation[]
  jobs              Job[]
  runs              Run[]
  artifacts         Artifact[]
  summaries         ConversationSummary[]
  escalations       HitlEscalation[]
  roiMetrics        RoiMetric[]
  roiSnapshots      RoiSnapshot[]
  memoryNamespaces  MemoryNamespace[]
  scheduledJobs     ScheduledJob[]
  memoryPromotions  MemoryPromotion[]
}

model MemoryNamespace {
  id                     String   @id
  deploymentId           String
  scope                  String
  searchEnabled          Boolean  @default(true)
  summaryRefreshSchedule String?
  createdAt              DateTime @default(now())
  deployment             TwinDeployment @relation(fields: [deploymentId], references: [id])
  entries                MemoryEntry[]
  retrievalEvents        MemoryRetrievalEvent[]
  promotions             MemoryPromotion[]
}

model MemoryEntry {
  id                 String   @id
  memoryNamespaceId  String
  entryType          String
  content            String
  summaryText        String?
  sensitivityLevel   String?
  promotionCandidate Boolean  @default(false)
  createdAt          DateTime @default(now())
  memoryNamespace    MemoryNamespace @relation(fields: [memoryNamespaceId], references: [id])
}

model MemoryRetrievalEvent {
  id                String   @id
  deploymentId      String
  memoryNamespaceId String
  runId             String?
  queryText         String
  matchedEntryIds   Json?
  retrievalStrategy String?
  usedInResponse    Boolean?
  createdAt         DateTime @default(now())
  deployment        TwinDeployment @relation(fields: [deploymentId], references: [id])
  memoryNamespace   MemoryNamespace @relation(fields: [memoryNamespaceId], references: [id])
  run               Run? @relation(fields: [runId], references: [id])
}

model Conversation {
  id            String   @id
  deploymentId  String
  channelType   String
  requesterId   String
  status        String
  title         String?
  createdAt     DateTime @default(now())
  deployment    TwinDeployment @relation(fields: [deploymentId], references: [id])
  messages      Message[]
  jobs          Job[]
  summaries     ConversationSummary[]
  escalations   HitlEscalation[]
}

model Message {
  id             String   @id
  conversationId String
  direction      String
  authorType     String
  authorId       String
  body           String
  createdAt      DateTime @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
}

model Job {
  id             String   @id
  deploymentId   String
  conversationId String?
  jobType        String
  status         String
  requestSummary String?
  createdAt      DateTime @default(now())
  deployment     TwinDeployment @relation(fields: [deploymentId], references: [id])
  conversation   Conversation?  @relation(fields: [conversationId], references: [id])
  runs           Run[]
}

model Run {
  id              String   @id
  jobId           String
  deploymentId    String
  status          String
  modelProfile    String?
  modelName       String?
  tokenInput      Int?
  tokenOutput     Int?
  usefulnessScore Float?
  scoreConfidence Float?
  startedAt       DateTime?
  completedAt     DateTime?
  job             Job      @relation(fields: [jobId], references: [id])
  deployment      TwinDeployment @relation(fields: [deploymentId], references: [id])
  summaries       ConversationSummary[]
}

model ConversationSummary {
  id                   String   @id
  conversationId       String
  deploymentId         String
  sourceRunId          String?
  summaryType          String
  content              String
  openQuestions        String?
  recommendedNextSteps String?
  confidenceScore      Float?
  isHandoffReady       Boolean  @default(false)
  createdAt            DateTime @default(now())
  conversation         Conversation @relation(fields: [conversationId], references: [id])
  deployment           TwinDeployment @relation(fields: [deploymentId], references: [id])
  sourceRun            Run? @relation(fields: [sourceRunId], references: [id])
  escalations          HitlEscalation[]
}

model HitlEscalation {
  id                   String   @id
  deploymentId         String
  conversationId       String
  jobId                String?
  runId                String?
  conversationSummaryId String?
  status               String
  reasonCode           String
  requestedHumanId     String?
  deliveryStatus       String?
  responseDueAt        DateTime?
  createdAt            DateTime @default(now())
  deployment           TwinDeployment @relation(fields: [deploymentId], references: [id])
  conversation         Conversation @relation(fields: [conversationId], references: [id])
  summary              ConversationSummary? @relation(fields: [conversationSummaryId], references: [id])
  deliveries           NotificationDelivery[]
}

model NotificationDelivery {
  id           String   @id
  subjectType  String
  subjectId    String
  channelType  String
  recipientRef String?
  status       String
  sentAt       DateTime?
  failedAt     DateTime?
  failureReason String?
  createdAt    DateTime @default(now())
  escalationId String?
  escalation   HitlEscalation? @relation(fields: [escalationId], references: [id])
}

model Artifact {
  id           String   @id
  deploymentId String
  artifactType String
  storageUri   String
  displayName  String?
  createdAt    DateTime @default(now())
  deployment   TwinDeployment @relation(fields: [deploymentId], references: [id])
}

model RoiMetric {
  id                String   @id
  deploymentId      String
  metricName        String
  direction         String
  baselineValue     Float
  targetValue       Float?
  measurementMethod String?
  createdAt         DateTime @default(now())
  deployment        TwinDeployment @relation(fields: [deploymentId], references: [id])
}

model RoiSnapshot {
  id                        String   @id
  deploymentId              String
  weekStart                 DateTime
  primaryMetricValue        Float
  improvementVsBaselinePct  Float
  weeklyRoiDelta            Float
  usefulnessScore           Float?
  usefulCompletionRate      Float?
  curveClassification       String?
  dataQualityScore          Float?
  createdAt                 DateTime @default(now())
  deployment                TwinDeployment @relation(fields: [deploymentId], references: [id])
}

model ScheduledJob {
  id           String   @id
  deploymentId String
  jobType      String
  schedule     String
  enabled      Boolean  @default(true)
  deliveryMode String
  config       Json?
  lastRunAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deployment   TwinDeployment @relation(fields: [deploymentId], references: [id])
}

model MemoryPromotion {
  id                String   @id
  deploymentId      String
  digitalTwinId     String
  memoryNamespaceId String?
  promotionType     String
  sourceType        String
  sourceId          String
  status            String
  proposedPatch     Json?
  approvedAt        DateTime?
  createdAt         DateTime @default(now())
  deployment        TwinDeployment @relation(fields: [deploymentId], references: [id])
  digitalTwin       DigitalTwin @relation(fields: [digitalTwinId], references: [id])
  memoryNamespace   MemoryNamespace? @relation(fields: [memoryNamespaceId], references: [id])
}
