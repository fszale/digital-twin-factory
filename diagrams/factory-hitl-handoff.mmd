    style SYN fill:#1a4a2e,color:#fff,stroke:#4ade80
    style DASH fill:#1a3a5c,color:#fff,stroke:#4a9ede
    style SLACK fill:#1a3a5c,color:#fff,stroke:#4a9ede
    style AUDIT fill:#2a2a2a,color:#fff,stroke:#6b7280
